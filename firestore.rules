rules_version = '2';

// Reglas de seguridad de Firestore - SEPAM / Centros de Vida
//
// Roles (campo `role` del documento users/{uid}):
//   district          → Distrito: lee todo, administra usuarios, sedes y metas.
//   contractor-admin  → Representante/administrador del contratista: su equipo y sus actividades.
//                       adminType 'main' (o sin adminType) = representante principal.
//   data-entry        → Encargado de carga: registra actividades a nombre de los profesionales
//                       de su contratista.
//   field             → Profesional de campo: registra y consulta sus actividades. Puede no
//                       tener cuenta (hasLogin == false): solo existe para que otro registre por él.
//
// Quién puede registrar actividades lo decide el representante legal en
// contractorSettings/{contractor}.registration { professionals, dataEntry, representative }
// (por defecto, todos).
// Un usuario con active == false no puede leer ni escribir nada.
//
// Desplegar con:  firebase deploy --only firestore:rules,firestore:indexes
// o copiando este archivo en Firebase Console → Firestore → Reglas.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function me() {
      return get(profilePath()).data;
    }

    function isActive() {
      return signedIn() && exists(profilePath()) && me().get('active', true) != false;
    }

    function isDistrict() {
      return isActive() && me().role == 'district';
    }

    function isContractorAdmin() {
      return isActive() && me().role == 'contractor-admin';
    }

    function isMainContractorAdmin() {
      return isContractorAdmin() && me().get('adminType', 'main') == 'main';
    }

    function isDataEntry() {
      return isActive() && me().role == 'data-entry';
    }

    function myContractor() {
      return me().contractor;
    }

    function settingsPath(contractor) {
      return /databases/$(database)/documents/contractorSettings/$(contractor);
    }

    function registrationAllows(key) {
      return !exists(settingsPath(myContractor()))
        || get(settingsPath(myContractor())).data.get('registration', {}).get(key, true) != false;
    }

    // ¿El usuario puede registrar actividades según la decisión de su entidad?
    function canRegister() {
      return (me().role == 'field' && registrationAllows('professionals'))
        || (me().role == 'data-entry' && registrationAllows('dataEntry'))
        || (me().role == 'contractor-admin' && registrationAllows('representative'));
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // Profesional que realizó la actividad: un profesional solo registra a su nombre;
    // el encargado o el representante eligen un profesional de campo de su contratista.
    function performerIsValid(data) {
      return (me().role == 'field'
          && (data.get('performedBy', null) == null || data.performedBy.uid == request.auth.uid))
        || (me().role != 'field'
          && data.get('performedBy', null) != null
          && exists(userPath(data.performedBy.uid))
          && get(userPath(data.performedBy.uid)).data.contractor == myContractor()
          && get(userPath(data.performedBy.uid)).data.role == 'field');
    }

    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // ---------------------------------------------------------------- users
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid)
        || isDistrict()
        || (isContractorAdmin() && resource.data.contractor == myContractor())
        // El encargado de carga necesita la lista de profesionales de su contratista
        || (isDataEntry() && resource.data.contractor == myContractor());

      // Solo un administrador crea perfiles (la cuenta de Auth se crea aparte, o no existe
      // para profesionales sin acceso). Un contratista solo crea profesionales, encargados
      // de carga o administradores secundarios de su contratista.
      allow create: if isDistrict()
        || (isContractorAdmin()
            && request.resource.data.contractor == myContractor()
            && request.resource.data.role in ['field', 'data-entry', 'contractor-admin']
            && request.resource.data.get('adminType', 'secondary') != 'main');

      allow update: if isDistrict()
        // Representante principal: edita su equipo sin cambiar de contratista ni crear principales
        || (isMainContractorAdmin()
            && resource.data.contractor == myContractor()
            && unchanged('contractor')
            && unchanged('uid')
            && unchanged('email')
            && request.resource.data.role in ['field', 'data-entry', 'contractor-admin']
            && (unchanged('adminType') || request.resource.data.get('adminType', 'secondary') != 'main'))
        // Cada usuario: solo sus datos de perfil
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name', 'displayName', 'photoURL', 'updatedAt']));

      allow delete: if isDistrict();
    }

    // ----------------------------------------------------------- activities
    match /activities/{activityId} {
      allow read: if isDistrict()
        || (isActive() && resource.data.createdBy.uid == request.auth.uid)
        // Profesional: actividades que un encargado o el representante registraron a su nombre
        || (isActive() && resource.data.performedBy.uid == request.auth.uid)
        || (isContractorAdmin() && resource.data.contractor == myContractor())
        // Personal de campo: actividades aprobadas de su contratista (comparativos)
        || (isActive() && resource.data.contractor == myContractor() && resource.data.status == 'approved');

      // Toda actividad nace pendiente, registrada por quien la carga, en su contratista,
      // si su entidad permite que ese rol registre y con un profesional válido
      allow create: if isActive()
        && request.resource.data.createdBy.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && (isDistrict()
            || (request.resource.data.contractor == myContractor()
                && canRegister()
                && performerIsValid(request.resource.data)));

      allow update: if isDistrict()
        // Aprobar / rechazar una actividad pendiente de su contratista
        || (isContractorAdmin()
            && resource.data.contractor == myContractor()
            && resource.data.status == 'pending'
            && request.resource.data.status in ['approved', 'rejected']
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'approvedBy', 'approvedAt', 'rejectionReason']))
        // Autor: corregir una actividad rechazada y devolverla a revisión
        || (isActive()
            && resource.data.createdBy.uid == request.auth.uid
            && resource.data.status == 'rejected'
            && request.resource.data.status == 'pending'
            && unchanged('createdBy')
            && unchanged('contractor')
            && unchanged('createdAt')
            && (unchanged('performedBy') || performerIsValid(request.resource.data)));

      // El autor puede borrar mientras esté pendiente
      allow delete: if isDistrict()
        || (isActive() && resource.data.createdBy.uid == request.auth.uid && resource.data.status == 'pending');
    }

    // ------------------------------------------------------------ locations
    match /locations/{locationId} {
      allow read: if isDistrict()
        || (isActive() && resource.data.contractor == myContractor());
      allow write: if isDistrict();
    }

    // --------------------------------------------------- contractorSettings
    // Configuración de cada entidad (quién registra actividades). La decide el
    // representante legal (administrador principal) o el distrito.
    match /contractorSettings/{contractorId} {
      allow read: if isDistrict() || (isActive() && contractorId == myContractor());
      allow write: if isDistrict()
        || (isMainContractorAdmin()
            && contractorId == myContractor()
            && request.resource.data.contractor == contractorId);
    }

    // ---------------------------------------------------------------- goals
    // Id del documento: {contractor}_{year}
    match /goals/{goalId} {
      allow read: if isDistrict()
        || (isActive() && (resource == null || resource.data.contractor == myContractor()));
      allow write: if isDistrict();
    }

    // Todo lo demás: denegado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
